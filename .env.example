DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
API_PORT=8787
# Set to 1 only behind a reverse proxy that overwrites X-Real-IP / X-Forwarded-For.
TRUST_PROXY=0
QWEATHER_API_KEY=your_qweather_api_key
# Replace your-api-host with the dedicated API Host from the QWeather console.
QWEATHER_BASE_URL=https://your-api-host/v7
QWEATHER_GEO_URL=https://your-api-host/geo/v2
